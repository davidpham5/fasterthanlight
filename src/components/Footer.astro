---
import { site } from '../lib/content';

const year = new Date().getFullYear();
// One string, so formatting can never drop the spaces between the parts.
const credit = `© ${year} ${site.name} · ${site.owner} · `;
---

<footer class="site-footer">
  <p>
    {credit}
    <a href={`mailto:${site.email}`}>{site.email}</a>
  </p>
</footer>

<style>
  .site-footer {
    padding: 1.5rem var(--gutter) 2rem;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    text-align: center;
    color: var(--muted);
  }
  p {
    margin: 0;
  }
</style>
